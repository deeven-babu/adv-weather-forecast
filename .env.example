# Copy this file to .env for local development. Never commit real secrets.
SECRET_KEY=replace-with-a-long-random-value
FLASK_DEBUG=1

# Use DATABASE_URL for a complete connection string, or configure MySQL below.
# DATABASE_URL=mysql+pymysql://username:password@localhost/weather_ai
DB_HOST=localhost
DB_PORT=3306
DB_NAME=weather_ai
DB_USER=replace-with-mysql-user
DB_PASSWORD=replace-with-mysql-password

# --- Phase 4: security -----------------------------------------------------
# Set to 1 when the app is served over HTTPS. Leave unset for local http.
SESSION_COOKIE_SECURE=0
# Optional: send a Content-Security-Policy header. Only enable after checking
# the dashboard, which loads Leaflet and Three.js from a CDN.
ENABLE_CSP=0
# Lightweight login throttling.
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=300
MAX_CONTENT_LENGTH=2097152

# --- Phase 3: notifications (optional) -------------------------------------
# Without these the app still runs; delivery is simply reported as
# "unavailable" instead of "sent". Never commit real values.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=1
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=
SMS_ENDPOINT=